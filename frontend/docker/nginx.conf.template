server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    add_header X-Content-Type-Options nosniff;

    # Nunca en caché: si el navegador guardara estos archivos, no vería las versiones nuevas ni la dirección de la API actual
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    location = /ngsw.json {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
    location = /ngsw-worker.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Archivos con huella en el nombre (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css): no cambian nunca
    location ~* ^/(main|chunk|polyfills|styles)-[A-Za-z0-9]+\.(js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Las rutas de la aplicación (Angular) devuelven index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
