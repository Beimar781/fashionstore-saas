{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "app", "installMode": "prefetch", "resources": { "files": ["/favicon.ico", "/index.csr.html", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "!/config.js"] } },
    { "name": "assets", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"] } },
    { "name": "mediapipe-local", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/mediapipe/pose_landmarker_lite.task", "/mediapipe/wasm/**/*.js", "/mediapipe/wasm/**/*.wasm"] } }
  ],
  "dataGroups": [
    {
      "name": "imagenes-prendas",
      "urls": ["http://localhost:8000/media/**", "http://127.0.0.1:8000/media/**", "https://*.up.railway.app/media/**", "/media/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 500, "maxAge": "30d" }
    },
    {
      "name": "api-consultas",
      "urls": ["http://localhost:8000/api/**", "http://127.0.0.1:8000/api/**", "https://*.up.railway.app/api/**", "/api/**"],
      "cacheConfig": { "strategy": "freshness", "maxSize": 100, "maxAge": "1d", "timeout": "5s" }
    }
  ]
}
