# Copiar a .env y ajustar usuario/contraseña de TU PostgreSQL (el de pgAdmin)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fashionstore_saas
SECRET_KEY=cambiar-esta-clave-larga-y-secreta
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Recuperación de contraseña. Sin BREVO_API_KEY el enlace se imprime en la consola del backend.
FRONTEND_URL=http://localhost:4200
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@su-dominio.com
# Imágenes de productos (una carpeta por empresa). Por defecto: backend/media
# MEDIA_DIR=media
# MEDIA_MAX_MB=5
