# Copiar a .env y completar. Este archivo NO lleva claves reales y .env nunca se sube a git.
# En Railway estas mismas variables se crean en el servicio «backend» (pestaña Variables); ver docs/DESPLIEGUE.md.

# ---------- Base de datos ----------
# Local: el PostgreSQL de pgAdmin (ajuste usuario y contraseña).
# Railway: ${{Postgres.DATABASE_URL}} (llega como postgresql://...; el backend lo convierte solo a postgresql+psycopg://).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fashionstore_saas

# ---------- Seguridad ----------
# Clave larga y secreta para firmar los tokens. En producción el backend NO arranca con la de por defecto.
# Genere una:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-larga-y-secreta
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
# desarrollo | produccion (Railway ya define RAILWAY_ENVIRONMENT y cuenta como producción)
# ENTORNO=produccion

# ---------- Direcciones ----------
# CORS_ORIGINS: URL pública del frontend (sin barra final); varias separadas por coma. FRONTEND_URL: la misma URL (enlaces de los correos).
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_URL=http://localhost:4200

# ---------- Imágenes (productos y PNG del vestidor) ----------
# En Railway: /app/media, con un Volume montado en esa ruta.
# MEDIA_DIR=media
# MEDIA_MAX_MB=5

# ---------- Datos de demostración ----------
# true = al arrancar, después de las migraciones, carga el seed SOLO si la base está vacía (nunca duplica) y repone las imágenes de demostración si el volumen está vacío.
# CARGAR_DATOS_DEMO=true

# ---------- Correo (Brevo) ----------
# Sin BREVO_API_KEY el enlace de recuperación de contraseña se imprime en la consola del backend.
# BREVO_SENDER_EMAIL debe ser un remitente VERIFICADO en Brevo. Compruébelo con:  python scripts/probar_correo.py destino@correo.com
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=FashionStore

# ---------- Pagos con tarjeta (Stripe, CU-32) ----------
# Sin estas dos claves el sistema usa un pago simulado. Use SIEMPRE las claves de PRUEBA (sk_test_ y pk_test_).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- IA (CU-07 asistente, CU-23 reportes generativos, CU-42) ----------
# gemini (gratuito, sin tarjeta; clave de Google AI Studio) | anthropic (Claude, de pago). Sin clave se usa el modo de respaldo con reglas locales.
# IA_PROVEEDOR=gemini
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# Vacío = el modelo por defecto del proveedor (gemini-flash-latest o claude-haiku-5-5).
# IA_MODELO=

# ---------- Notificaciones push ----------
# Web (VAPID): genere las claves con  python scripts/generar_vapid.py  y pegue las dos líneas. Sin ellas el push web queda simulado.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:soporte@su-dominio.com
# Móvil (Firebase Cloud Messaging): ID del proyecto de Firebase y el contenido COMPLETO del JSON de la cuenta de servicio (en una sola variable).
# Local, si prefiere un archivo:  FCM_CREDENCIALES=ruta/al/archivo.json
# FCM_PROYECTO=
# FCM_CREDENCIALES_JSON=

# ---------- Otros ----------
# Servicio de impuestos (CU-30): hoy es simulado. Con true simula que no responde y la venta emite un comprobante interno temporal.
# IMPUESTOS_SIMULAR_FALLA=true
