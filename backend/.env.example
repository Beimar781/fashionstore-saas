# Copiar a .env y ajustar usuario/contraseña de TU PostgreSQL (el de pgAdmin)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/fashionstore_saas
SECRET_KEY=cambiar-esta-clave-larga-y-secreta
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Recuperación de contraseña. Sin BREVO_API_KEY el enlace se imprime en la consola del backend.
FRONTEND_URL=http://localhost:4200
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=no-reply@su-dominio.com
# Pagos con tarjeta (CU-32). Sin estas dos claves el sistema usa un pago simulado con tarjetas de prueba.
# Use SIEMPRE las claves de PRUEBA de Stripe (empiezan con sk_test_ y pk_test_); nunca claves reales. Este archivo no se sube a git.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Imágenes de productos (una carpeta por empresa). Por defecto: backend/media
# MEDIA_DIR=media
# MEDIA_MAX_MB=5
# Servicio de impuestos (CU-30): hoy es simulado. Con true simula que no responde y la venta emite un comprobante interno temporal.
# IMPUESTOS_SIMULAR_FALLA=true
